---
import Base from "../layouts/Base.astro";
import { achievements } from "../data/achievements";
---
<Base title="Achievements">
  <h1 class="display text-5xl">Achievements</h1>
  <ul class="mt-10 divide-y divide-haze border-y border-haze">
    {achievements.map((a) => (
      <li class="grid gap-1 py-6 sm:grid-cols-[1fr_auto] sm:gap-6">
        <div>
          <h2 class="title text-2xl">{a.title}</h2>
          <p class="mt-1 text-slate">{a.org}</p>
          <p class="mt-2 max-w-[60ch]">{a.description}</p>
        </div>
        {a.year && <p class="text-slate sm:text-right">{a.year}</p>}
      </li>
    ))}
  </ul>
</Base>
