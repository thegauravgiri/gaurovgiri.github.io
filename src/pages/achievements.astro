---
import Base from "../layouts/Base.astro";
import { achievements } from "../data/achievements";
const groups = [...new Set(achievements.map((a) => a.group))];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---
<Base title="Achievements" wide description="Peer-reviewed research and community leadership by Gaurav Giri.">
  <header class="max-w-3xl">
    <h1 class="display text-5xl">Achievements</h1>
    <p class="mt-4 max-w-[58ch] text-lg text-slate">The recognition I'm proudest of: peer-reviewed research and leading developer communities in Nepal.</p>
  </header>

  {groups.map((g) => (
    <section class="mt-14" aria-labelledby={slug(g)}>
      <h2 id={slug(g)} class="eyebrow">{g}</h2>
      <ul class="mt-4 grid gap-5 md:grid-cols-2">
        {achievements.filter((a) => a.group === g).map((a, _, list) => (
          <li class:list={["card flex flex-col", list.length === 1 && "md:col-span-2"]}>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="pill-accent">{a.result}</span>
              {a.year && <span class="text-sm text-slate">{a.year}</span>}
            </div>
            <h3 class="title mt-3 text-xl">{a.event}</h3>
            <p class="mt-2 text-slate">{a.description}</p>
            {a.link && (
              <p class="mt-auto pt-4">
                <a class="link ext text-sm" href={a.link.href} target="_blank" rel="noopener noreferrer">{a.link.label}</a>
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
