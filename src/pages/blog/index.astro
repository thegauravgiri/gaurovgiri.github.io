---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
const posts = (await getCollection("blog", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base title="Writing" description="Notes on speech, language models, computer vision and building things in Nepal.">
  <h1 class="display text-5xl">Writing</h1>
  <p class="mt-4 max-w-[52ch] text-lg text-slate">Notes on speech, language models, computer vision and building things in Nepal.</p>
  <ul class="mt-10 divide-y divide-haze border-y border-haze">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}`} class="group grid gap-1 py-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
          <time class="text-slate" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <span>
            <span class="title block text-xl group-hover:underline group-hover:decoration-marigold group-hover:decoration-2 group-hover:underline-offset-4">{p.data.title}</span>
            {p.data.description && <span class="mt-1 block text-slate">{p.data.description}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
