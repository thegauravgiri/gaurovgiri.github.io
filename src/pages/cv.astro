---
import Base from "../layouts/Base.astro";
const UPDATED = "November 2026";
// role: bold; org: accent; when: right-aligned on desktop.
type Item = { role: string; org?: string; when?: string; where?: string; body?: string; points?: string[] };
const sections: { name: string; items: Item[] }[] = [
  {
    name: "Summary",
    items: [{
      role: "AI and software engineer",
      body: "Licensed computer engineer (Nepal Engineering Council) with 5+ years across AI agents and retrieval, Nepali speech AI, computer vision and the backend systems that keep them reliable in production. Published researcher and developer-community lead.",
    }],
  },
  {
    name: "Experience",
    items: [
      {
        role: "AI & Software Engineer", org: "Proshore", when: "Apr 2026 – now", where: "Kathmandu · hybrid",
        points: [
          "Build multi-agent assistants for international enterprise clients that answer questions over company documents, with citations back to the exact page.",
          "Retrieval from SharePoint via Microsoft Graph with per-user access control, hybrid search in PostgreSQL with pgvector, and query rewriting for multi-turn follow-ups.",
          "Evaluation harnesses on every pull request for agent behaviour, tool calling and grounding.",
          "Reliability work: rate limiting and backoff, durable chat sessions, and moving bulk indexing to a throttled queue so it can't starve live chat.",
        ],
      },
      {
        role: "AI Engineer", org: "ekGhanti Services", when: "Apr 2025 – Mar 2026", where: "Kathmandu",
        points: [
          "Nepali voice AI for phone calls, with sentiment, intent and automatic summaries; it handled 90,000+ live calls.",
          "Fine-tuned a Conformer speech-to-text model on Nepali phone audio to 16.8% word error rate, and SpeechT5 text-to-speech with voice cloning and language identification.",
          "Model-serving layer with dynamic batching and priority queues: 92% lower peak latency across OCR, STT and TTS.",
          "Handwritten Nepali OCR for citizenship documents (86%+ field accuracy) and a multi-tenant RAG service for four enterprise clients.",
        ],
      },
      {
        role: "Software Developer (freelance, part-time)", org: "Anmup Online", when: "Feb 2020 – Jan 2025", where: "Remote",
        points: [
          "Flutter app for the Bagmati Provincial Assembly to manage meetings and legislative documents (500+ installs).",
          "Travel authorisation system for the Public Health Service Office, Jumla, with role-based approvals and PDF orders.",
          "Secure medical report archive for NDC Dharan; scrapers, APIs and websites for other clients.",
        ],
      },
    ],
  },
  {
    name: "Research",
    items: [
      { role: "Lightweight parasitic egg detection using a modified YOLOv11 with Ghost convolutions, hybrid SimAM-ECA attention and DropBlock", org: "International Journal on Engineering Technology, Vol. 3 No. 1", when: "2025", body: "0.9627 mAP@0.5 and 0.92 F1 with 58% fewer parameters than the baseline." },
      { role: "CNN-based bird sound detection: a comparative performance study", org: "International Journal on Engineering Technology, Vol. 2 No. 2", when: "2025", body: "Mel-spectrogram features; a tuned ResNet50 reached 90.75% accuracy in noisy outdoor audio." },
    ],
  },
  {
    name: "Skills",
    items: [
      { role: "Languages", body: "Python, C/C++, TypeScript, JavaScript, SQL, Bash, Dart" },
      { role: "AI and ML", body: "PyTorch, Hugging Face, LangChain, LlamaIndex, vLLM; RAG, multi-agent systems, MCP, tool calling; speech (Conformer, SpeechT5, voice cloning); vision (YOLO, OCR, OpenCV); evaluation and guardrails" },
      { role: "Backend and data", body: "FastAPI, Django, Flask, Node.js; PostgreSQL with pgvector, Redis, Celery; WebSockets, SSE; OAuth 2.1, KMS encryption, RBAC" },
      { role: "Cloud", body: "Azure (OpenAI, App Service, DevOps), AWS (EC2, S3, Bedrock), Google Cloud (Cloud Run, KMS, BigQuery); Docker, GitHub Actions, NGINX, Linux" },
    ],
  },
  {
    name: "Education",
    items: [
      { role: "B.E. Computer Engineering", org: "Kantipur Engineering College, Tribhuvan University", when: "2021 – 2025", body: "Distinction, 81.3%." },
      { role: "FuseAI Fellowship", org: "Fusemachines", when: "2022 – 2023", body: "Deep learning, NLP, computer vision and production ML." },
      { role: "Data Fellowship", org: "Code for Nepal", when: "2023 – 2024" },
      { role: "DevOps Engineering", org: "Broadway Infosys", when: "2024" },
    ],
  },
  {
    name: "Community",
    items: [
      { role: "Ed-Tech Lead", org: "Google Developer Groups Kathmandu", when: "2024 – now", body: "DevFest Kathmandu and Google I/O Extended." },
      { role: "Organiser", org: "UbuCon Asia 2025, Kathmandu", when: "2025" },
      { role: "Campus Leader", org: "Notion" },
    ],
  },
];
const contacts = [
  { label: "gaurovgiri@gmail.com", href: "mailto:gaurovgiri@gmail.com" },
  { label: "linkedin.com/in/thegauravgiri", href: "https://www.linkedin.com/in/thegauravgiri" },
  { label: "github.com/thegauravgiri", href: "https://github.com/thegauravgiri" },
  { label: "gauravgiri.com.np", href: "https://www.gauravgiri.com.np" },
];
---
<Base title="CV" wide description="CV of Gaurav Giri, AI and software engineer in Kathmandu, open to remote work.">
  <div class="max-w-4xl">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
    <div class="min-w-0">
      <h1 class="display text-5xl">Gaurav Giri</h1>
      <p class="mt-3 text-lg font-medium">AI & Software Engineer · Kathmandu, Nepal · open to remote and relocation</p>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-slate">
        {contacts.map((c) => <a class="link" href={c.href}>{c.label}</a>)}
      </p>
    </div>
    <div class="flex shrink-0 flex-col items-start gap-2 sm:items-end print:hidden">
      <button type="button" class="btn btn-primary print:hidden" onclick="window.print()">Save as PDF</button>
      <span class="text-sm text-slate">Updated {UPDATED}</span>
    </div>
  </div>
  <div class="mt-10 border-t border-haze">
    {sections.map((s) => (
      <section class="grid gap-3 border-b border-haze py-7 break-inside-avoid-page sm:grid-cols-[9.5rem_1fr] sm:gap-10">
        <h2 class="eyebrow pt-1">{s.name}</h2>
        <div class="space-y-6">
          {s.items.map((i) => (
            <div class="break-inside-avoid">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <p class="font-semibold">{i.role}{i.org && <span class="font-medium text-accent-text"> · {i.org}</span>}</p>
                {i.when && <p class="text-sm tabular-nums text-slate">{i.when}</p>}
              </div>
              {i.where && <p class="text-sm text-slate">{i.where}</p>}
              {i.body && <p class="mt-1 max-w-[72ch] text-slate">{i.body}</p>}
              {i.points && (
                <ul class="mt-2 max-w-[72ch] list-disc space-y-1 pl-5 text-slate marker:text-haze">
                  {i.points.map((p) => <li>{p}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p class="mt-6 hidden text-sm text-slate print:block">Updated {UPDATED} · latest version at gauravgiri.com.np/cv</p>
  </div>
</Base>
